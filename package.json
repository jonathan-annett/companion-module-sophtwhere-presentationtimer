{
	"name": "companion-module-sophtwhere-presentationtimer",
	"version": "0.2.0",
	"main": "dist/main.js",
	"type": "module",
	"description": "Bitfocus Companion connection for the Presentation Timer (timed-show.com, timer.sophtwhere.com or your own copy): every timer command as actions, the timer's variables and states as variables and feedbacks",
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "run build && node --test \"dist/__tests__/*.test.js\""
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonathan-annett/companion-module-sophtwhere-presentationtimer.git"
	},
	"engines": {
		"node": ">=22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.0.4",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^22.15.0",
		"@types/ws": "^8.5.13",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.0.1",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
